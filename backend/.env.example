# ──────────────────────────────────────────────
# CampusConnect — Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# Django
# Generate a real key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True

# Which settings module to use: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Allowed hosts (comma-separated, used in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (only needed when using production settings)
DB_NAME=campusconnect
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated origins, used in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

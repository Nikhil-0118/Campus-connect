# ──────────────────────────────────────────────
# CampusConnect — Render Production Environment Variables
# Copy these to your Render Web Service Environment Settings
# ──────────────────────────────────────────────

# 1. Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.production

# 2. Secret Key (Generate a secure random string or let Render generate it)
SECRET_KEY=your-production-secret-key-here

# 3. Database URL (Auto-provided by Render if using Render PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://user:password@hostname.render.com:5432/campusconnect_db

# 4. Allowed Hosts (Comma-separated list of backend domains, e.g., your-app.onrender.com)
ALLOWED_HOSTS=campusconnect-backend.onrender.com

# 5. CORS Allowed Origins (Comma-separated list of frontend origins, e.g. Vercel app URL)
CORS_ALLOWED_ORIGINS=https://campusconnect.vercel.app,http://localhost:5173

# 6. CSRF Trusted Origins (Comma-separated list of trusted origins for form/API POST requests)
CSRF_TRUSTED_ORIGINS=https://campusconnect.vercel.app,https://campusconnect-backend.onrender.com
